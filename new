function adminTeachers(ts){const all=[...DEMO_TEACHERS,...ts];return`<div class="card"><h2>Teachers</h2><p class="muted">Review teacher details and verify their profiles before they appear in student search.</p>${all.length?`<table><tr><th>Teacher</th><th>Board</th><th>Status</th><th>Documents</th><th></th></tr>${all.map(t=>`<tr><td><b>${esc(t.name)}</b>${t.trial?' <span class="demo">TRIAL</span>':''}</td><td>${esc(t.board)}</td><td>${t.verified?'<span class="pill green">Verified</span>':'<span class="pill">Pending</span>'}</td><td>${(t.documents||[]).length}</td><td>${t.trial?'<span class="muted">Demo</span>':`<button class="btn secondary" onclick="viewTeacher('${t.id}')">Open</button>`}</td></tr>`).join("")}</table>`:`<div class="empty">No teachers.</div>`}</div>`}
function adminStudents(ss){return`<div class="card"><h2>Students</h2>${ss.length?`<table><tr><th>Name</th><th>Class</th><th>Board</th><th>School</th></tr>${ss.map(s=>`<tr><td>${esc(s.name)}</td><td>${esc(s.className)}</td><td>${esc(s.board)}</td><td>${esc(s.school)}</td></tr>`).join("")}</table>`:`<div class="empty">No students registered.</div>`}</div>`}
function viewTeacher(id){const t=adminData().find(x=>x.id===id);if(!t)return; shell(`<button class="back" onclick="adminTab('teachers')">← Back</button><div class="card">${profileCard(t,true)}<div class="notice">${t.verified?"✓ Verified":"Verification pending"}</div><h3>Uploaded document information</h3>${(t.documents||[]).length?t.documents.map(d=>`<div class="notice">📄 ${esc(d.name)} · ${esc(d.type||"file")}</div>`).join(""):"<p class='muted'>No documents.</p>"}<div class="actions">${!t.verified?`<button class="btn green" onclick="approveTeacher('${id}')">Approve & Publish</button>`:`<button class="btn red" onclick="unverifyTeacher('${id}')">Suspend</button>`}</div></div>`)}
function approveTeacher(id){let u=adminData();const i=u.findIndex(x=>x.id===id);if(i<0)return;u[i].verified=true;u[i].verificationStatus="approved";u[i].active=true;localSet("users",u);alert("Teacher approved and published.");adminTab("teachers")}
function unverifyTeacher(id){let u=adminData();const i=u.findIndex(x=>x.id===id);if(i<0)return;u[i].verified=false;u[i].verificationStatus="suspended";localSet("users",u);alert("Teacher suspended.");adminTab("teachers")}
function adminHourlyRequests(ts){const req=ts.filter(t=>t.teachesSenior);return `<div class="card"><h2>Class 11–12 Hourly Fee Requests</h2><p class="muted">Approve the teacher's requested hourly fee before it appears to students.</p>${req.length?`<table><tr><th>Teacher</th><th>Subjects</th><th>Requested fee/hour</th><th>Status</th><th>Action</th></tr>${req.map(t=>`<tr><td>${esc(t.name)}</td><td>${esc(t.seniorSubjects||"Not specified")}</td><td>₹${Number(t.hourlyFeeRequested||0)}</td><td>${t.hourlyFeeStatus==="approved"?`<span class="pill green">Approved: ₹${Number(t.hourlyFeeApproved||t.hourlyFeeRequested)}</span>`:`<span class="pill">Pending approval</span>`}</td><td>${t.hourlyFeeStatus==="approved"?"—":`<button class="btn green" onclick="approveHourlyFee('${t.id}')">Approve fee</button>`}</td></tr>`).join("")}</table>`:`<div class="empty">No Class 11–12 fee requests yet.</div>`}</div>`}
function approveHourlyFee(id){const u=adminData(),i=u.findIndex(x=>x.id===id);if(i<0)return;u[i].hourlyFeeApproved=Number(u[i].hourlyFeeRequested||0);u[i].hourlyFeeStatus="approved";localSet("users",u);alert("Hourly fee approved and will be shown to students.");adminTab("hourly")}
function seniorBooking(){if(!seniorEligible())return alert("One-hour Class 11–12 sessions are available only to students registered in Class 11 or Class 12.");const ts=getTeachers().filter(t=>t.teachesSenior&&t.hourlyFeeStatus==="approved");shell(`<button class="back" onclick="studentHome()">← Back</button><div class="card"><h2>Book a One-Hour Session</h2><p class="muted">For Class 11–12 topic explanation or doubt solving.</p><div class="grid2"><div class="field"><label>Class</label><select id="seniorClass"><option>11</option><option>12</option></select></div><div class="field"><label>Subject</label><input id="sessionSubject" placeholder="e.g. Physics"></div></div><div class="field"><label>Session type</label><select id="sessionType"><option>Explain a topic</option><option>Doubt solving</option></select></div><div class="field"><label>Topic / doubt details</label><textarea id="sessionTopic" rows="3" placeholder="Write the topic or doubt"></textarea></div><div class="field"><label>Preferred date</label><input id="sessionDate" type="date"></div><div class="field"><label>Preferred time</label><input id="sessionTime" type="time"></div></div>${ts.length?ts.map(t=>`<div class="card">${profileCard(t,true)}<p><b>Subjects:</b> ${esc(t.seniorSubjects||"")}</p><div class="promo"><p>Teacher hourly fee</p><div class="price">₹${Number(t.hourlyFeeApproved||0)}</div><p>+ ₹200 EduBridge booking charge</p><h3>Total for 1 hour: ₹${Number(t.hourlyFeeApproved||0)+200}</h3><p class="muted">₹100 monthly student subscription is separate.</p></div><button class="btn green full" onclick="requestSeniorBooking('${t.id}')">Request Booking · ₹${Number(t.hourlyFeeApproved||0)+200}</button></div>`).join(""):`<div class="card empty"><p>No approved Class 11–12 hourly teachers are available yet.</p></div>`}`)}
function requestSeniorBooking(id){const t=getTeachers().find(x=>x.id===id);if(!t)return;const req={id:"session-"+Date.now(),studentId:state.user.id,studentName:state.profile.name,teacherId:t.id,teacherName:t.name,className:document.getElementById("seniorClass").value,subject:document.getElementById("sessionSubject").value.trim(),type:document.getElementById("sessionType").value,topic:document.getElementById("sessionTopic").value.trim(),date:document.getElementById("sessionDate").value,time:document.getElementById("sessionTime").value,teacherFee:Number(t.hourlyFeeApproved||0),platformFee:200,total:Number(t.hourlyFeeApproved||0)+200,status:"booking-requested",createdAt:new Date().toISOString()};if(!req.subject||!req.topic||!req.date||!req.time)return alert("Please fill subject, topic/doubt, date and time.");const a=localGet("hourlyBookings",[]);a.push(req);localSet("hourlyBookings",a);shell(`<div class="card"><h2>Booking request created</h2><div class="notice success">Your one-hour booking request has been saved in this demo.</div><p>Teacher: <b>${esc(t.name)}</b></p><p>Total: <b>₹${req.total}</b> (₹${req.teacherFee} teacher fee + ₹200 EduBridge charge)</p><p class="muted">Payment processing and teacher confirmation must be connected for production.</p><button class="btn" onclick="studentHome()">Back to Home</button></div>`)}
function publishUpdate(){const title=document.getElementById("ut").value.trim(),message=document.getElementById("um").value.trim();if(!title||!message)return alert("Fill both fields.");let a=localGet("announcements",[]);a.unshift({title,message,createdAt:new Date().toISOString()});localSet("announcements",a);alert("Update published.");adminDashboard()}
setupFirebase().then(ok=>{if(!ok)welcome()});
Object.assign(window,{welcome,authScreen,toggleAuth,doAuth,logout,nav,studentHome,searchTeachers,connectTeacher,sendChat,acceptTeacher,demoPay,rateTeacher,saveRating,connections,schedule,leavePage,timePage,supportPage,submitSupport,submitComplaint,submitDoubt,submitProgress,notifications,teacherHome,submitTeacherVerification,teacherStudents,adminDashboard,adminTab,viewTeacher,approveTeacher,unverifyTeacher,publishUpdate,seniorBooking,requestSeniorBooking,approveHourlyFee,updateComplaint,saveDoubtReview});
</script></body></html>
