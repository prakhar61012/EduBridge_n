function submitSupport(){const message=document.getElementById("supportMessage")?.value.trim();if(!message)return alert("Please enter your message.");const a=localGet("supportRequests",[]);a.push({id:"support-"+Date.now(),userId:state.user.id,userName:state.profile.name,role:state.role,message,status:"Submitted",createdAt:new Date().toISOString()});localSet("supportRequests",a);alert("Support request saved in this demo.");supportPage()}
